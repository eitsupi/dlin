        }
      },
      "compiled_code": "with\nbase_orders as (\n    select * from \"shop\".\"main\".\"stg_orders\"\n),\nwith_payments as (\n    select\n        base_orders.*,\n        p.amount\n    from base_orders\n    left join \"shop\".\"main\".\"stg_payments\" p on base_orders.order_id = p.order_id\n),\nfinal as (\n    select * from with_payments\n)\nselect * from final",
      "database": "shop",
      "schema": "main"
