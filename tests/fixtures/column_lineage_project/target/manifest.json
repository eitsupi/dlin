    "model.clp.orders": {
      "unique_id": "model.clp.orders",
      "name": "orders",
      "resource_type": "model",
      "depends_on": {
        "nodes": [
          "model.clp.stg_orders",
          "model.clp.stg_payments"
        ]
      },
      "config": { "materialized": "table", "tags": ["marts"] },
      "description": "Orders fact table with CTE+SELECT* pattern and 3-part names",
      "path": "models/marts/orders.sql",
      "columns": {
        "order_id": { "name": "order_id" },
        "customer_id": { "name": "customer_id" },
        "order_date": { "name": "order_date" },
        "status": { "name": "status" },
        "total_amount": { "name": "total_amount" },
        "payment_method": { "name": "payment_method" }
      },
      "compiled_code": "with\norder_data as (\n    select * from \"shop\".\"main\".\"stg_orders\"\n),\npayment_data as (\n    select * from \"shop\".\"main\".\"stg_payments\"\n)\nselect\n    order_data.order_id,\n    order_data.customer_id,\n    order_data.order_date,\n    order_data.status,\n    payment_data.amount as total_amount,\n    payment_data.payment_method\nfrom order_data\nleft join payment_data on order_data.order_id = payment_data.order_id",
      "database": "shop",
      "schema": "main"
    },
    "model.clp.customers": {
      "unique_id": "model.clp.customers",
      "name": "customers",
      "resource_type": "model",
      "depends_on": {
        "nodes": [
          "model.clp.stg_customers",
          "model.clp.orders"
        ]
      },
      "config": { "materialized": "table", "tags": ["marts"] },
      "description": "Customers dimension with aggregation — no YAML columns (tests SQL inference)",
      "path": "models/marts/customers.sql",
      "compiled_code": "select\n    c.customer_id,\n    c.first_name,\n    c.last_name,\n    c.email,\n    count(o.order_id) as order_count,\n    sum(o.total_amount) as lifetime_value\nfrom \"shop\".\"main\".\"stg_customers\" c\nleft join \"shop\".\"main\".\"orders\" o on c.customer_id = o.customer_id\ngroup by 1, 2, 3, 4",
      "database": "shop",
      "schema": "main"
    },
    "model.clp.order_enriched": {
      "unique_id": "model.clp.order_enriched",
      "name": "order_enriched",
      "resource_type": "model",
      "depends_on": {
        "nodes": [
          "model.clp.stg_orders",
          "model.clp.stg_payments"
        ]
      },
      "config": { "materialized": "view", "tags": ["marts"] },
      "description": "Nested CTE with SELECT* through multiple levels",
      "path": "models/marts/order_enriched.sql",
      "columns": {
        "order_id": { "name": "order_id" },
        "customer_id": { "name": "customer_id" },
        "order_date": { "name": "order_date" },
        "status": { "name": "status" },
        "amount": { "name": "amount" }
      },
      "compiled_code": "with\nbase_orders as (\n    select * from \"shop\".\"main\".\"stg_orders\"\n),\nwith_payments as (\n    select\n        base_orders.*,\n        p.amount\n    from base_orders\n    left join \"shop\".\"main\".\"stg_payments\" p on base_orders.order_id = p.order_id\n),\nfinal as (\n    select * from with_payments\n)\nselect * from final",
      "database": "shop",
      "schema": "main"
    }
