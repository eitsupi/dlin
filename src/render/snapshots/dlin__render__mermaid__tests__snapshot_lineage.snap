---
source: src/render/mermaid.rs
expression: output
---
flowchart LR
    source_raw_orders(["raw.orders"]) 
    model_stg_orders["stg_orders"]
    model_orders["orders"]
    test_orders_positive{"orders_positive"} 
    exposure_dashboard>"dashboard"]

    source_raw_orders -.->|source| model_stg_orders
    model_stg_orders -->|ref| model_orders
    model_orders -.->|test| test_orders_positive
    model_orders ==>|exposure| exposure_dashboard

    classDef model fill:#4A90D9,stroke:#333,color:#fff
    classDef source fill:#27AE60,stroke:#333,color:#fff
    classDef seed fill:#F39C12,stroke:#333,color:#fff
    classDef snapshot fill:#8E44AD,stroke:#333,color:#fff
    classDef test fill:#1ABC9C,stroke:#333,color:#fff
    classDef exposure fill:#E74C3C,stroke:#333,color:#fff
    classDef phantom fill:#BDC3C7,stroke:#333,color:#000
    class source_raw_orders source
    class model_stg_orders model
    class model_orders model
    class test_orders_positive test
    class exposure_dashboard exposure
